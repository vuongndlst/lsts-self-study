node_modules
dist

# Dựng lại từ docs/huong-dan mỗi lần build (scripts/gom-tai-lieu.mjs). Giữ hai
# bản của mấy chục MB video trong git thì kiểu gì cũng có lúc lệch nhau.
public/tai-lieu
.DS_Store

# Mọi file .env chứa secret — KHÔNG commit.
.env
.env.local
.env.admin
.env.*.local

# Chỉ các file mẫu/không chứa secret được commit.
!.env.example
!.env.admin.example
!.env.production

supabase/seed-roster.private.sql
supabase/.temp/

# Cấu hình lớp chứa tên học sinh — chỉ giữ lại file mẫu.
admin/*.json
admin/*.csv
!admin/class.example.json

.claude/

_test-session.mjs

# Danh sách mật khẩu tạm. KHO NÀY CÔNG KHAI trên GitHub — một lần commit nhầm là
# mật khẩu của cả tổ giáo viên nằm vĩnh viễn trong lịch sử, xoá file đi cũng
# không gỡ được. Chặn theo thư mục và theo tên, phòng cả hai đường.
docs/huong-dan/*.xlsx
docs/huong-dan/*.csv
*[Mm]at khau*
*[Mm]at-khau*
*[Pp]assword*.xlsx
*[Pp]assword*.csv

# Tài liệu và video dành cho GIÁO VIÊN. Kho này công khai, mà phần giáo viên thì
# chỉ giáo viên đăng nhập mới được xem — để trong git là mở toang cho cả thế
# giới. Nó nằm trong bucket riêng tư trên Supabase:
#   supabase/schema-15-tai-lieu-gv.sql   chính sách truy cập
#   scripts/tai-len-tai-lieu.mjs         đẩy lên sau khi dựng lại
#
# GIỮ LẠI .chuong.json: chỉ là tên và mốc từng phần, trang web cần nó lúc build
# để dựng danh sách nhảy tới từng phần.
docs/huong-dan/Huong-dan-giao-vien.docx
docs/huong-dan/Huong-dan-giao-vien.pdf
docs/huong-dan/bia-giao-vien.jpg
docs/huong-dan/video/giao-vien/*.mp4
docs/huong-dan/video/giao-vien/*.srt
